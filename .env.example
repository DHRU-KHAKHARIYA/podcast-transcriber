# HuggingFace token — required for pyannote diarization models
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Whisper model size: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL=base

# Device: cpu | cuda
WHISPER_DEVICE=cpu

# Compute type: int8 (cpu) | float16 (cuda) | float32
WHISPER_COMPUTE_TYPE=int8

# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./podcast_transcriber.db
